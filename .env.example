PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Auth credentials for login endpoint
AUTH_USERNAME=admin
AUTH_PASSWORD=supersecret

# JWT configuration
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h

# Rate limiter overrides (optional)
MAX_REQUESTS=5

# Keep-alive / public URLs
PUBLIC_BASE_URL=http://localhost:5000
SELF_PING_ENABLED=true
SELF_PING_URL=http://localhost:5000/
SELF_PING_INTERVAL_MS=840000

